,4),e=easter(y),M=new Map([[`${y}-01-01`,"Neujahr"],[add(e,-2),"Karfreitag"],[add(e,1),"Ostermontag"],[`${y}-05-01`,"Tag der Arbeit"],[add(e,39),"Christi Himmelfahrt"],[add(e,50),"Pfingstmontag"],[add(e,60),"Fronleichnam"],[`${y}-10-03`,"Tag der Deutschen Einheit"],[`${y}-11-01`,"Allerheiligen"],[`${y}-12-25`,"1. Weihnachtstag"],[`${y}-12-26`,"2. Weihnachtstag"]]);return{isHoliday:M.has(d),holiday:M.get(d)||"",dayBeforeHoliday:M.has(add(d,1)),dayAfterHoliday:M.has(add(d,-1))}}
function sessionSecret(){return process.env.SESSION_SECRET||crypto.createHash("sha256").update(`pep-planer-session:${process.env.DATABASE_URL}`).digest("hex")}
function signed(raw){return crypto.createHmac("sha256",sessionSecret()).update(raw).digest("hex")}
function cookie(req,name){let f=String(req.headers.cookie||"").split(";").map(x=>x.trim()).find(x=>x.startsWith(name+"="));if(!f)return null;let tok=f.slice(name.length+1),p=tok.split(".");if(p.length!==2||!p[0]||p[1]!==signed(p[0]))return null;try{return JSON.parse(Buffer.from(p[0],"base64url").toString("utf8"))}catch{return null}}
function session(req){let a=cookie(req,"plan_admin_session");if(a?.role==="admin")return a;let e=cookie(req,"plan_employee_session")||cookie(req,"plan_session");return e?.role==="employee"&&e.name?e:null}
function manager(s){if(s?.role==="admin")return true;let x=n(s?.name);return x==="demircan emirkan"||x==="emirkan demircan"}
function auth(req,res,mgr=false){let s=session(req);if(!s||mgr&&!manager(s)){json(res,s?403:401,{error:s?"Keine Berechtigung.":"Nicht angemeldet."});return null}return s}
async function cred(){let r=await pool().query("SELECT value #>> '{revenueSettings,email}' email,value #>> '{revenueSettings,passwordEncrypted}' enc FROM app_store WHERE key='db'"),email=process.env.GMX_EMAIL||r.rows[0]?.email||"edemircan@gmx.net",pass=process.env.GMX_APP_PASSWORD||"";if(!pass&&r.rows[0]?.enc){let key=crypto.createHash("sha256").update(`pep-revenue:${sessionSecret()}`).digest(),p=r.rows[0].enc.split(".");try{let dc=crypto.createDecipheriv("aes-256-gcm",key,Buffer.from(p[0],"base64url"));dc.setAuthTag(Buffer.from(p[1],"base64url"));pass=Buffer.concat([dc.update(Buffer.from(p[2],"base64url")),dc.final()]).toString()}catch{}}if(!pass)throw Error("GMX nicht eingerichtet");return{email,pass}}
function parse(buf){const X=require("xlsx"),w=X.read(buf,{type:"buffer",cellDates:true}),Q=[],D=[];for(const sn of w.SheetNames){let rows=X.utils.sheet_to_json(w.Sheets[sn],{header:1,raw:true,defval:null,blankrows:false}),hi=-1,keys=[];for(let i=0;i<Math.min(80,rows.length);i++){let k=(rows[i]||[]).map(hk);if(new Set(k.filter(Boolean)).size>=4&&k.includes("qty")){hi=i;keys=k;break}}if(hi<0)continue;let c={article:"",name:"",date:""};for(const row of rows.slice(hi+1)){let o={};keys.forEach((k,i)=>{if(k&&o[k]===undefined)o[k]=row[i]});let no=article(o.article),name=String(o.name||"").trim(),date=iso(o.date),sl=slot(o.slot);if(!no&&o.article){no=article(o.article);if(!name)name=String(o.article).replace(no,"").trim()}if(no)c.article=no;else no=c.article;if(name)c.name=name;else name=c.name;if(date)c.date=date;else date=c.date;if(!no||!date||/gesamt|ergebnis|summe/i.test(name))continue;let x={date,slot:sl,no,name:name||no,qty:num(o.qty),revenue:num(o.revenue),writeoff:Math.abs(num(o.writeoff)),action:num(o.action)};(sl?Q:D).push(x)}}return{Q,D}}
function blankModel(){return{version:2,sourceMinDate:null,sourceMaxDate:null,updatedAt:null,g:{},items:{}}}
function fixModel(x){if(!x||typeof x!=="object")return blankModel();x.version=2;x.g=x.g&&typeof x.g==="object"?x.g:{};x.items=x.items&&typeof x.items==="object"?x.items:{};return x}
async function loadModel(force=false){await init();if(modelCache&&!force)return modelCache;let r=await pool().query("SELECT payload FROM bakery_model WHERE market_code=$1",[MARKET]);modelCache=fixModel(r.rows[0]?.payload||blankModel());return modelCache}
async function saveModel(m){m=fixModel(m);m.updatedAt=new Date().toISOString();await pool().query("INSERT INTO bakery_model(market_code,payload,updated_at) VALUES($1,$2,now()) ON CONFLICT(market_code) DO UPDATE SET payload=$2,updated_at=now()",[MARKET,m]);modelCache=m;return m}
function slotIndex(v){let m=String(v||"").match(/(\d{1,2}):(\d{2})/);if(!m)return-1;let z=+m[1]*60 + +m[2];return z>=0&&z<1440?Math.floor(z/15):-1}
function arr96(v){let a=Array.isArray(v)?v.slice(0,96).map(x=>Math.max(0,+x||0)):[];while(a.length<96)a.push(0);return a}
function dayEntry(item,date){item.d=Array.isArray(item.d)?item.d:[];let e=item.d.find(x=>Array.isArray(x)&&x[0]===date);if(!e){e=[date,0,0,0,0];item.d.push(e)}while(e.length<5)e.push(0);return e}
function mergeRows(model,Q,D,after=""){model=fixModel(model);let cat=catalog(),byCore=new Map;for(const i of cat){let k=core(i.name);if(!byCore.has(k))byCore.set(k,[]);byCore.get(k).push(i)}function find(name){let c=core(name);if(c.includes("berliner")&&!/\b(?:4|6|8|12)\s*st\b/.test(n(name)))return cat.find(x=>x.name==="Berliner Auswahl")||null;if(c.includes("donut")&&!c.includes("crodot")&&!/\b(?:4|6|8|12)\s*st\b/.test(n(name)))return cat.find(x=>x.name==="Donut Auswahl")||null;if(c.includes("laugenkranz"))return cat.find(x=>x.name==="Laugenkranz Auswahl")||null;return(byCore.get(c)||[]).find(x=>brandOk(x.name,name))||null}
  let touched=false,min=model.sourceMinDate,max=model.sourceMaxDate;for(const r of Q){if(after&&r.date<=after)continue;let it=find(r.name);if(!it)continue;let q=qFor(it,r),si=slotIndex(r.slot);if(si<0)continue;let x=model.items[it.no]||(model.items[it.no]={n:it.name,d:[],s:{}}),e=dayEntry(x,r.date);e[1]+=q;e[2]+=Math.max(0,+r.revenue||0);let k=String(wd(r.date)),sa=arr96(x.s[k]);sa[si]+=q;x.s[k]=sa;let ga=arr96(model.g[k]);ga[si]+=q;model.g[k]=ga;touched=true;min=!min||r.date<min?r.date:min;max=!max||r.date>max?r.date:max}
  for(const r of D){if(after&&r.date<=after)continue;let it=find(r.name);if(!it)continue;let x=model.items[it.no]||(model.items[it.no]={n:it.name,d:[],s:{}}),e=dayEntry(x,r.date),q=qFor(it,r);if(e[1]<=0&&q>0)e[1]=q;if(+r.revenue)e[2]=Math.max(0,+r.revenue||0);e[3]=Math.abs(+r.writeoff||0);e[4]=Math.max(0,+r.action||0);touched=true;min=!min||r.date<min?r.date:min;max=!max||r.date>max?r.date:max}
  if(touched){model.sourceMinDate=min;model.sourceMaxDate=max;for(const x of Object.values(model.items)){x.d=(Array.isArray(x.d)?x.d:[]).filter(e=>Array.isArray(e)&&/^\d{4}-\d{2}-\d{2}$/.test(e[0])).sort((a,b)=>a[0].localeCompare(b[0])).slice(-400)}}return touched}
async function importMail(opts={}){