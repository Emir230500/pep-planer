await init();const{ImapFlow}=require("imapflow"),{simpleParser}=require("mailparser"),c=await cred(),client=new ImapFlow({host:"imap.gmx.net",port:993,secure:true,auth:{user:c.email,pass:c.pass},logger:false}),days=Math.max(2,Math.min(400,+opts.days||3)),forceAfter=String(opts.forceAfter||"");let files=0,rows=0,model=await loadModel(),changed=false,seen=[];try{await client.connect();let lock=await client.getMailboxLock("INBOX");try{let q={since:new Date(Date.now()-days*86400000),from:process.env.REVENUE_REPORT_SENDER||"NoReplyBerichtsexport@edeka.de"},u=await client.search(q,{uid:true});u=u.slice(-(opts.maxMessages||80));for(const id of u.reverse()){let m=await client.fetchOne(id,{envelope:true,source:true},{uid:true});if(!m?.source)continue;let x=await simpleParser(m.source);for(const a of x.attachments||[]){if(!/\.xlsx?$/i.test(a.filename||""))continue;let sid=crypto.createHash("sha256").update(`${x.messageId||id}|${a.filename}`).digest("hex"),known=(await pool().query("SELECT 1 FROM bakery_mail WHERE source_id=$1",[sid])).rowCount>0;if(known&&!forceAfter)continue;let r;try{r=parse(a.content)}catch{continue}if(!r.Q.length&&!r.D.length)continue;let hit=mergeRows(model,r.Q,r.D,forceAfter);if(!hit)continue;changed=true;files++;rows+=r.Q.length+r.D.length;if(!known)seen.push(sid)}}}finally{lock.release()}}finally{if(client.usable)await client.logout().catch(()=>{})}if(changed){await pool().query("BEGIN");try{await saveModel(model);for(const sid of seen)await pool().query("INSERT INTO bakery_mail(source_id) VALUES($1) ON CONFLICT DO NOTHING",[sid]);await pool().query("COMMIT")}catch(e){await pool().query("ROLLBACK");modelCache=null;throw e}}return{files,rows,sourceMaxDate:model.sourceMaxDate}}
async function weather(d){try{let u=`https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum&timezone=Europe%2FBerlin&start_date=${d}&end_date=${d}`,r=await fetch(u,{signal:AbortSignal.timeout(7000)}),j=await r.json();return{code:j.daily.weather_code[0],max:j.daily.temperature_2m_max[0],min:j.daily.temperature_2m_min[0],rain:j.daily.precipitation_sum[0]}}catch{return{unavailable:true}}}
function wf(w){if(w.unavailable)return 1;let f=1;if(w.max>=28)f-=.02;else if(w.max<=5)f+=.01;if(w.rain>=8)f+=.01;return clamp(f,.97,1.03)}
function mins(s){let[a,b]=String(s).slice(0,5).split(":").map(Number);return a*60+b}function hm(m){return`${String(Math.floor(m/60)).padStart(2,"0")}:${String(m%60).padStart(2,"0")}`}
function modelIntervals(target,M){let a=arr96(M.g?.[String(wd(target))]),start=22,end=80,tot=0;for(let i=start;i<end;i++)tot+=a[i];if(!tot)return[{name:"Morgen",from:"05:30",to:"10:30"},{name:"Mittag",from:"10:30",to:"14:00"},{name:"Nachmittag",from:"14:00",to:"20:00"}];let c=0,b1=42,b2=56;for(let i=start;i<end;i++){c+=a[i];if(c/tot>=.45&&b1===42)b1=i+1;if(c/tot>=.76){b2=i+1;break}}let m1=clamp(b1*15,570,690),m2=clamp(b2*15,m1+120,930);return[{name:"Morgen",from:"05:30",to:hm(m1)},{name:"Mittag",from:hm(m1),to:hm(m2)},{name:"Nachmittag",from:hm(m2),to:"20:00"}]}
function batchStep(it){if(it.type!=="Backplan")return 1;let vals=(it.ref||[]).slice(1).filter(v=>v>0).map(v=>Math.round(v));if(vals.length<2)return it.ref?.[0]>=12?3:it.ref?.[0]>=6?2:1;let gcd=(a,b)=>{while(b){let t=a%b;a=b;b=t}return Math.abs(a)},g=vals[0];for(const v of vals.slice(1))g=gcd(g,v);return clamp(g,1,8)}
function roundUp(v,s){return v<=0?0:Math.ceil(v/s)*s}
function weekStart(d){let z=new Date(d+"T12:00:00Z"),shift=(z.getUTCDay()+6)%7;z.setUTCDate(z.getUTCDate()-shift);return z.toISOString().slice(0,10)}
function momentum(target,daily){let by=new Map(daily.map(e=>[e[0],e])),start=weekStart(target),dow=wd(target),cur=[];for(let i=0;i<Math.max(0,dow-1);i++){let e=by.get(add(start,i));if(e)cur.push(+e[1]||0)}if(cur.length<2)return 1;let hist=[];for(let w=1;w<=4;w++)for(let i=0;i<Math.max(0,dow-1);i++){let e=by.get(add(start,i-7*w));if(e)hist.push(+e[1]||0)}if(hist.length<4||median(hist)<=0)return 1;let r=(cur.reduce((a,b)=>a+b,0)/cur.length)/(hist.reduce((a,b)=>a+b,0)/hist.length);return 1+.25*(clamp(r,.8,1.25)-1)}
function slotShares(x,target,I){let a=arr96(x?.s?.[String(wd(target))]),cuts=[mins(I[0].to),mins(I[1].to)],sum=[0,0,0];for(let i=22;i<80;i++){let m=i*15,j=m<cuts[0]?0:m<cuts[1]?1:2;sum[j]+=a[i]}let t=sum.reduce((p,q)=>p+q,0);return t?sum.map(v=>v/t):null}
function alloc(total,share){let raw=share.map(x=>x*total),out=raw.map(Math.floor),left=total-out.reduce((a,b)=>a+b,0);raw.map((v,i)=>({i,f:v-Math.floor(v)})).sort((a,b)=>b.f-a.f).slice(0,left).forEach(x=>out[x.i]++);return out}
async function plan(target){await init();let cat=catalog(),M=await loadModel(),I=modelIntervals(target,M),W=await weather(target),H=holiday(target),closed=wd(target)===0||H.isHoliday,items=[];for(const it of cat){let x=M.items?.[it.no]||null,daily=(x?.d||[]).filter(e=>Array.isArray(e)&&e[0]<target),same=daily.filter(e=>wd(e[0])===wd(target)).sort((a,b)=>b[0].localeCompare(a[0])).slice(0,10),source=same.length>=3?same:daily.slice().sort((a,b)=>b[0].localeCompare(a[0])).slice(0,24),base=0;if(source.length){let recent=source.slice(0,Math.min(6,source.length)),med=median(recent.map(e=>+e[1]||0)),wm=weighted(source.map((e,i)=>({value:+e[1]||0,weight:Math.pow(.84,i)})));base=.65*med+.35*wm;base*=momentum(target,daily);let py=String(+target.slice(0,4)-1),mo=target.slice(5,7),season=daily.filter(e=>e[0].startsWith(`${py}-${mo}-`)&&wd(e[0])===wd(target));if(season.length>=2)base=.9*base+.1*median(season.map(e=>+e[1]||0))}let rev=source.reduce((s,e)=>s+Math.max(0,+e[2]||0),0),wo=source.reduce((s,e)=>s+Math.max(0,+e[3]||0),0),ratio=rev+wo?wo/(rev+wo):0,buffer=clamp(.06-.4*ratio,.01,.06),raw=base*(1+buffer)*(H.dayBeforeHoliday?1.03:H.dayAfterHoliday?1.01:1)*wf(W),confidence=source.length>=5?"hoch":source.length>=3?"mittel":source.length?"niedrig":"fallback",ref=Math.max(0,+it.ref?.[0]||0);if(!source.length)raw=ref;else if(source.length<3&&ref)raw=.65*raw+.35*ref;let total=closed?0:roundUp(raw,batchStep(it)),share=it.type==="Auftauplan"?[1,0,0]:slotShares(x,target,I)||(it.type==="Brotplan"?[.60,.25,.15]:[.55,.30,.15]);let st=share.reduce((a,b)=>a+b,0);if(!st)share=[.58,.27,.15];else share=share.map(v=>v/st);let b=alloc(total,share);items.push({no:it.no,name:it.name,type:it.type,program:it.program,total,buckets:b,history:source.length,risk:ratio>=.08?"hoch":ratio>=.035?"mittel":"niedrig",confidence})}let payload={version:"auto-v2",planDate:target,intervals:I,items