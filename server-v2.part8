
// Flexible EDEKA workbook parser. Handles report variants whose column names differ
// from the original export (for example Absatz/Stückzahl instead of exactly Menge).
// Parsed rows still flow into the existing compact bakery model; no raw workbook is stored.
const bakeryParseOriginal=parse;
function bakeryHeaderKey(v){
  const h=n(v);
  if(!h)return"";
  if((h.includes("aktion")||h.includes("werbung"))&&(h.includes("menge")||h.includes("absatz")||h.includes("stuck")))return"action";
  if(h==="kalendertag"||h==="datum"||h==="tag"||h.includes("verkaufsdatum")||h.includes("umsatzdatum")||h.includes("berichtstag"))return"date";
  if(h.includes("viertelstunde")||h.includes("zeitintervall")||h.includes("zeitscheibe")||h==="uhrzeit"||h==="zeitraum")return"slot";
  if(h==="artikel"||h==="artikelnummer"||h==="artikelnr"||h==="artikel nr"||h==="art nr"||h==="artnr"||h.includes("artikel nummer"))return"article";
  if(h.includes("artikelbezeichnung")||h==="bezeichnung"||h==="artikelname"||h==="artikeltext"||h==="artikel text")return"name";
  if(h.includes("vollabschrift")||h.includes("abschrift"))return"writeoff";
  if(h==="umsatz"||h.includes("nettoumsatz")||h.includes("bruttoumsatz")||h.includes("warenumsatz"))return"revenue";
  if(h==="menge"||h==="absatz"||h==="stuck"||h==="stuckzahl"||h.includes("absatzmenge")||h.includes("verkaufsmenge")||h.includes("verkaufte menge")||h.includes("abverkauf")||h.includes("menge stk")||h.includes("menge st"))return"qty";
  return"";
}
function bakeryWorkbookDate(rows){
  for(let i=0;i<Math.min(50,rows.length);i++)for(const c of rows[i]||[]){const d=iso(c);if(d)return d}
  return"";
}
function bakeryFlexibleParse(buf){
  const X=require("xlsx"),w=X.read(buf,{type:"buffer",cellDates:true}),Q=[],D=[],cat=catalog(),catNo=new Map(cat.map(x=>[String(x.no),x]));
  for(const sn of w.SheetNames){
    const rows=X.utils.sheet_to_json(w.Sheets[sn],{header:1,raw:true,defval:null,blankrows:false});
    let best=null;
    for(let i=0;i<Math.min(140,rows.length);i++){
      const keys=(rows[i]||[]).map(bakeryHeaderKey),known=keys.filter(Boolean),score=new Set(known).size;
      if(!keys.includes("qty"))continue;
      if(!keys.includes("article")&&!keys.includes("name"))continue;
      if(!best||score>best.score)best={i,keys,score};
    }
    if(!best)continue;
    const keys=best.keys,defaultDate=bakeryWorkbookDate(rows.slice(0,best.i+1));
    let carry={article:"",name:"",date:defaultDate};
    for(const row of rows.slice(best.i+1)){
      const o={};keys.forEach((k,i)=>{if(k&&o[k]===undefined)o[k]=row[i]});
      let no=article(o.article),name=String(o.name||"").trim(),date=iso(o.date)||carry.date||defaultDate,sl=slot(o.slot);
      if(!no){for(const c of row||[]){no=article(c);if(no)break}}
      if(no)carry.article=no;else no=carry.article;
      const ref=no?catNo.get(String(no)):null;
      if(ref)name=ref.name;
      if(name)carry.name=name;else name=carry.name;
      if(date)carry.date=date;else date=carry.date;
      if(!no||!date||/gesamt|ergebnis|summe/i.test(name))continue;
      const x={date,slot:sl,no,name:name||ref?.name||no,qty:num(o.qty),revenue:num(o.revenue),writeoff:Math.abs(num(o.writeoff)),action:num(o.action)};
      (sl?Q:D).push(x);
    }
  }
  if(Q.length||D.length){console.log(`[bakery-parse] flexible EDEKA report parsed: ${Q.length} q15 + ${D.length} daily rows`);return{Q,D}}
  return bakeryParseOriginal(buf);
}
parse=bakeryFlexibleParse;
