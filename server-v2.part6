async function activateAnnualSeed(){try{await init();const r=await pool().query("SELECT payload FROM bakery_model WHERE market_code=$1",[MARKET]),p=r.rows[0]?.payload;if(!p)return;if(p.sourceMinDate&&p.sourceMaxDate&&p.items&&Object.keys(p.items).length>=20){modelCache=fixModel(p);return}const zlib=require("zlib"),c=[];if(Array.isArray(p.repair_parts)&&p.repair_parts.length===4&&Array.isArray(p.brotli_parts)&&p.brotli_parts.length===6){const b=p.brotli_parts,q=p.repair_parts;c.push(["brotli",b[0]+b[1]+q[0]+b[2]+q[1]+b[3]+q[2]+b[4]+q[3]+b[5]])}if(typeof p.gzip==="string")c.push(["gzip",p.gzip]);if(Array.isArray(p.gzip_parts)&&p.gzip_parts.length)c.push(["gzip",p.gzip_parts.join("")]);if(typeof p.brotli==="string")c.push(["brotli",p.brotli]);if(Array.isArray(p.brotli_parts)&&p.brotli_parts.length)c.push(["brotli",p.brotli_parts.join("")]);let M=null,last=null;for(const [mode,encoded] of c){if(!encoded)continue;try{const buf=Buffer.from(encoded,"base64"),raw=(mode==="gzip"?zlib.gunzipSync(buf):zlib.brotliDecompressSync(buf)).toString("utf8"),x=fixModel(JSON.parse(raw));if(!x.sourceMinDate||!x.sourceMaxDate||Object.keys(x.items||{}).length<20)throw Error("Jahreshistorie unvollständig");M=x;break}catch(e){last=e}}if(!M){if(last)throw last;return}modelCache=null;await saveModel(M);await pool().query("INSERT INTO bakery_jobs(job_key,ran_at) VALUES('bakery-annual-seed-v1',now()) ON CONFLICT(job_key) DO UPDATE SET ran_at=now()");const z=berlin();await plan(z.date);await plan(add(z.date,1));console.log(`[bakery-model] annual seed activated: ${M.sourceMinDate}..${M.sourceMaxDate}, ${Object.keys(M.items).length} items`)}catch(e){console.error("bakery annual seed",e.message)}}
setTimeout(activateAnnualSeed,1200).unref();
