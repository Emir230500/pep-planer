async function activateAnnualSeed(){try{await init();const r=await pool().query("SELECT payload FROM bakery_model WHERE market_code=$1",[MARKET]),p=r.rows[0]?.payload;if(!p)return;let encoded="";if(typeof p.brotli==="string")encoded=p.brotli;else if(Array.isArray(p.brotli_parts))encoded=p.brotli_parts.join("");if(!encoded)return;const zlib=require("zlib"),raw=zlib.brotliDecompressSync(Buffer.from(encoded,"base64")).toString("utf8"),M=fixModel(JSON.parse(raw));if(!M.sourceMinDate||!M.sourceMaxDate||Object.keys(M.items||{}).length<20)throw Error("Jahreshistorie unvollständig");modelCache=null;await saveModel(M);await pool().query("INSERT INTO bakery_jobs(job_key,ran_at) VALUES('bakery-annual-seed-v1',now()) ON CONFLICT(job_key) DO UPDATE SET ran_at=now()");const z=berlin();await plan(z.date);await plan(add(z.date,1));console.log(`[bakery-model] annual seed activated: ${M.sourceMinDate}..${M.sourceMaxDate}, ${Object.keys(M.items).length} items`)}catch(e){console.error("bakery annual seed",e.message)}}
setTimeout(activateAnnualSeed,1200).unref();
