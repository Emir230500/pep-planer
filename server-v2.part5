
async function seedExistingDaily(){try{await init();let done=(await pool().query("SELECT 1 FROM bakery_jobs WHERE job_key='bakery-seed-appstore-v1'")).rowCount;if(done)return;let r=await pool().query(`SELECT e->>'date' AS date,a->>'articleNo' AS no,a->>'articleName' AS name,COALESCE(NULLIF(a->>'quantity','')::numeric,0)::float8 AS qty,COALESCE((a->>'revenue')::numeric,0)::float8 AS revenue,COALESCE((a->>'writeOffsGross')::numeric,0)::float8 AS writeoff FROM app_store s CROSS JOIN LATERAL jsonb_array_elements(COALESCE(s.value->'backshopArticleEntries','[]'::jsonb)) e CROSS JOIN LATERAL jsonb_array_elements(COALESCE(e->'articles','[]'::jsonb)) a WHERE s.key='db' AND e->>'date' ~ '^\\d{4}-\\d{2}-\\d{2}$'`),D=r.rows.map(x=>({date:x.date,no:x.no,name:x.name,qty:+x.qty||0,revenue:+x.revenue||0,writeoff:Math.abs(+x.writeoff||0),action:0})),M=await loadModel();if(mergeRows(M,[],D,''))await saveModel(M);await pool().query("INSERT INTO bakery_jobs(job_key,ran_at) VALUES('bakery-seed-appstore-v1',now()) ON CONFLICT DO NOTHING");let z=berlin();await plan(z.date);await plan(add(z.date,1));console.log(`[bakery-model] seeded daily history: ${D.length} rows, ${M.sourceMinDate||'-'}..${M.sourceMaxDate||'-'}`)}catch(e){console.error("bakery daily seed",e.message)}}
setTimeout(seedExistingDaily,8000).unref();
try{const f=path.join(__dirname,"public/produktion.html");let h=fs.readFileSync(f,"utf8");h=h.replace('>Tag ${x.total}<','>Gesamt heute ${x.total}<');if(!h.includes('/production-live.js'))h=h.replace('</body>','<script src="/production-live.js?v=20260918-1"></script>\n</body>');fs.writeFileSync(f,h)}catch(e){console.error("production live patch",e.message)}
