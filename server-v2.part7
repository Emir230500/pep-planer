
// Exact evening bakery mail checks: 20:35 primary, 20:45 safety retry (Europe/Berlin).
// No raw report data is stored; importMail keeps only the compact model and de-duplicates mail sources.
const bakeryEveningSlots = new Set();
async function runBakeryEveningCheck(slot){
  const z=berlin(), key=`${z.date}:${slot}`;
  if(bakeryEveningSlots.has(key))return;
  bakeryEveningSlots.add(key);
  try{
    const imported=await importMail({days:3,maxMessages:80});
    if(imported?.files>0){
      const target=add(z.date,1);
      const p=await plan(target);
      console.log(`[bakery-auto] ${slot} import: ${imported.files} file(s), ${imported.rows} row(s), source ${imported.sourceMaxDate||'-'}, next plan ${target} (${p.payload.totals.all} pcs)`);
    }else{
      console.log(`[bakery-auto] ${slot} check: no new bakery report`);
    }
  }catch(e){
    console.error(`[bakery-auto] ${slot} check failed`,e.message);
  }
}
function bakeryEveningTick(){
  const z=berlin();
  if(z.hour!==20)return;
  if(z.minute>=35&&z.minute<45)return void runBakeryEveningCheck('20:35');
  if(z.minute>=45)return void runBakeryEveningCheck('20:45');
}
setTimeout(bakeryEveningTick,1500).unref();
setInterval(bakeryEveningTick,30000).unref();
