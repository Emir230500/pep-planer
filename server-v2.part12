
// Match renamed/supplier-switched bakery items conservatively. EDEKA report names can
// change while the physical product remains the same (e.g. Sonnenblumenkernbrötchen
// vs Sonnenblumenbrötchen 80g). Gram weights and supplier prefixes are not identities;
// pack counts such as 4ST/6ST/8ST remain significant.
core=function(s){
  return n(s)
    .replace(/nougatcr/g,"nougat")
    .replace(/schokoladengla/g,"schokoladenglasur")
    .replace(/crodots/g,"crodot")
    .replace(/sonnenblumenkern/g,"sonnenblumen")
    .split(" ")
    .filter(x=>x&&!STOP.has(x)&&!/^\d+(?:g|kg)?$/.test(x))
    .join(" ");
};
brandOk=function(a,b){
  const A=brand(a),B=brand(b);
  if(!A||!B||A===B)return true;
  // Supplier/brand changes are allowed only when the normalized product identity is exact.
  return core(a)===core(b);
};
function bakeryRepairFindV3(name,cat,byCore){
  const c=core(name);
  if(c.includes("berliner")&&!/\b(?:4|6|8|12)\s*st\b/.test(n(name)))return cat.find(x=>x.name==="Berliner Auswahl")||null;
  if(c.includes("donut")&&!c.includes("crodot")&&!/\b(?:4|6|8|12)\s*st\b/.test(n(name)))return cat.find(x=>x.name==="Donut Auswahl")||null;
  if(c.includes("laugenkranz"))return cat.find(x=>x.name==="Laugenkranz Auswahl")||null;
  const candidates=(byCore.get(c)||[]);
  if(candidates.length===1)return candidates[0];
  return candidates.find(x=>brandOk(x.name,name))||null;
}
async function repairMissingBakerySalesForDateV3(target){
  await init();
  const jobKey=`bakery-name-repair-v3:${target}`;
  if((await pool().query("SELECT 1 FROM bakery_jobs WHERE job_key=$1",[jobKey])).rowCount)return;
  const M=await loadModel(true),cat=catalog(),byCore=new Map();
  for(const it of cat){const k=core(it.name);if(!byCore.has(k))byCore.set(k,[]);byCore.get(k).push(it)}
  const missing=new Set(cat.filter(it=>{
    const d=(M.items?.[it.no]?.d||[]).find(e=>Array.isArray(e)&&e[0]===target);
    return !d||!(Number(d[1])>0);
  }).map(it=>String(it.no)));
  if(!missing.size){await pool().query("INSERT INTO bakery_jobs(job_key,ran_at) VALUES($1,now()) ON CONFLICT DO NOTHING",[jobKey]);return}
  const originalMerge=mergeRows,seenRows=new Set();
  mergeRows=function(model,Q,D,after=""){
    if(after&&after>=target)return originalMerge(model,[],[],after);
    const keep=(r,kind)=>{
      if(r.date!==target)return false;
      const it=bakeryRepairFindV3(r.name,cat,byCore);
      if(!it||!missing.has(String(it.no)))return false;
      const key=kind==="Q"?`Q|${r.date}|${r.slot}|${r.no}`:`D|${r.date}|${r.no}`;
      if(seenRows.has(key))return false;
      seenRows.add(key);return true;
    };
    return originalMerge(model,(Q||[]).filter(r=>keep(r,"Q")),(D||[]).filter(r=>keep(r,"D")),after);
  };
  try{
    const result=await importMail({days:5,maxMessages:500,forceAfter:add(target,-1)}),refreshed=await loadModel(true),repaired=[];
    for(const it of cat){
      if(!missing.has(String(it.no)))continue;
      const d=(refreshed.items?.[it.no]?.d||[]).find(e=>Array.isArray(e)&&e[0]===target);
      if(d&&Number(d[1])>0)repaired.push(`${it.no}:${it.name}=${Math.round(Number(d[1])||0)}`);
    }
    await pool().query("INSERT INTO bakery_jobs(job_key,ran_at) VALUES($1,now()) ON CONFLICT(job_key) DO UPDATE SET ran_at=now()",[jobKey]);
    console.log(`[bakery-repair-v3] ${target}: ${repaired.length?repaired.join(" | "):`no additional match; scanned ${result?.files||0} file(s)`}`);
  }finally{mergeRows=originalMerge}
}
// Repair the already imported 19.09 report once; future evening imports use the matcher above automatically.
setTimeout(()=>repairMissingBakerySalesForDateV3("2026-09-19").catch(e=>console.error("[bakery-repair-v3] failed",e.message)),14000).unref();

// Compact outside-plan learner. Unknown bakery articles are kept only as small daily
// aggregates inside bakery_model: no raw files, no extra table, max 24 items x 42 days.
const bakeryMergeKnownOnly=mergeRows;
const BAKERY_UNKNOWN_LIMIT=24,BAKERY_UNKNOWN_DAYS=42;
function bakeryUnknownCandidate(name){const s=n(name);return /(brot|brotchen|baguette|ciabatta|croissant|donut|berliner|laugen|franz|plunder|knoten|krust|brezel|crodot|muffin|cookie|teilchen|stange|fladen|pinky|spritz|rolle|tasche|wurst|pizza|quark|dinkel|roggen|weizen|korn|sonnenblum|bagel)/.test(s)}
function bakeryKnownName(name){const cat=catalog(),byCore=new Map();for(const it of cat){const k=core(it.name);if(!byCore.has(k))byCore.set(k,[]);byCore.get(k).push(it)}return !!bakeryRepairFindV3(name,cat,byCore)}
function bakeryPruneUnknown(model){model.u=model.u&&typeof model.u==='object'?model.u:{};const cutoff=add(berlin().date,-BAKERY_UNKNOWN_DAYS),rank=[];for(const [no,x] of Object.entries(model.u)){x.d=(Array.isArray(x.d)?x.d:[]).filter(e=>Array.isArray(e)&&e[0]>=cutoff&&/^\d{4}-\d{2}-\d{2}$/.test(e[0])).sort((a,b)=>a[0].localeCompare(b[0])).slice(-BAKERY_UNKNOWN_DAYS);if(!x.d.length){delete model.u[no];continue}rank.push([no,x.d.at(-1)[0]])}rank.sort((a,b)=>b[1].localeCompare(a[1]));for(const [no] of rank.slice(BAKERY_UNKNOWN_LIMIT))delete model.u[no]}
mergeRows=function(model,Q,D,after=''){
  const knownTouched=bakeryMergeKnownOnly(model,Q,D,after);
  if(after)return knownTouched;
  model=fixModel(model);model.u=model.u&&typeof model.u==='object'?model.u:{};
  let extraTouched=false;
  const apply=(r,daily)=>{
    if(!r?.no||!r?.date||bakeryKnownName(r.name)||!bakeryUnknownCandidate(r.name))return;
    const q=Math.max(0,+r.qty||0),rev=Math.max(0,+r.revenue||0),wo=Math.abs(+r.writeoff||0),act=Math.max(0,+r.action||0);
    if(q<=0&&wo<=0&&act<=0)return;
    const no=String(r.no),x=model.u[no]||(model.u[no]={n:String(r.name||no).trim()||no,d:[]}),e=dayEntry(x,r.date);
    if(r.name&&String(r.name).trim())x.n=String(r.name).trim();
    if(daily){if(e[1]<=0&&q>0)e[1]=q;if(rev>0)e[2]=rev;e[3]=wo;e[4]=act}else{e[1]+=q;e[2]+=rev}
    extraTouched=true;
  };
  for(const r of Q||[])apply(r,false);for(const r of D||[])apply(r,true);
  if(extraTouched)bakeryPruneUnknown(model);
  return knownTouched||extraTouched;
};
const bakeryPlanKnownOnly=plan;
plan=async function(target){
  const out=await bakeryPlanKnownOnly(target),M=await loadModel(),u=M.u&&typeof M.u==='object'?M.u:{},cat=catalog(),byCore=new Map();
  for(const it of cat){const k=core(it.name);if(!byCore.has(k))byCore.set(k,[]);byCore.get(k).push(it)}
  const extras=[];
  for(const [no,x] of Object.entries(u)){
    if(bakeryRepairFindV3(x.n,cat,byCore))continue;
    const daily=(x.d||[]).filter(e=>Array.isArray(e)&&e[0]<target&&(+e[1]||0)>0).sort((a,b)=>b[0].localeCompare(a[0])),same=daily.filter(e=>wd(e[0])===wd(target)).slice(0,8);
    if(daily.length<3||same.length<2)continue;
    const source=same,med=median(source.slice(0,6).map(e=>+e[1]||0)),wm=weighted(source.map((e,i)=>({value:+e[1]||0,weight:Math.pow(.84,i)}))),rev=source.reduce((s,e)=>s+Math.max(0,+e[2]||0),0),wo=source.reduce((s,e)=>s+Math.max(0,+e[3]||0),0),ratio=rev+wo?wo/(rev+wo):0,base=.7*med+.3*wm,raw=base*(1+clamp(.03-.35*ratio,0,.03))*wf(out.W||{unavailable:true}),total=out.ctx?.closed?0:Math.max(0,Math.ceil(raw));
    if(total<1)continue;
    extras.push({no:String(no),name:x.n,type:'Backplan',program:'Zusatzartikel',total,buckets:alloc(total,[.60,.25,.15]),history:source.length,risk:ratio>=.08?'hoch':ratio>=.035?'mittel':'niedrig',confidence:source.length>=5?'hoch':'mittel',learnedOutside:true});
  }
  extras.sort((a,b)=>b.history-a.history||b.total-a.total).splice(8);
  if(extras.length){
    const have=new Set((out.payload.items||[]).map(x=>String(x.no)));for(const x of extras)if(!have.has(String(x.no)))out.payload.items.push(x);
    out.payload.totals={all:out.payload.items.reduce((s,x)=>s+(+x.total||0),0),Backplan:out.payload.items.filter(x=>x.type==='Backplan').reduce((s,x)=>s+(+x.total||0),0),Brotplan:out.payload.items.filter(x=>x.type==='Brotplan').reduce((s,x)=>s+(+x.total||0),0),Auftauplan:out.payload.items.filter(x=>x.type==='Auftauplan').reduce((s,x)=>s+(+x.total||0),0)};
    await pool().query('UPDATE bakery_plans SET payload=$3 WHERE market_code=$1 AND plan_date=$2',[MARKET,target,out.payload]);
  }
  return out;
};
