,totals:{all:items.reduce((s,x)=>s+x.total,0),Backplan:items.filter(x=>x.type==="Backplan").reduce((s,x)=>s+x.total,0),Brotplan:items.filter(x=>x.type==="Brotplan").reduce((s,x)=>s+x.total,0),Auftauplan:items.filter(x=>x.type==="Auftauplan").reduce((s,x)=>s+x.total,0)}},ctx={...H,closed,weatherFactor:wf(W),modelVersion:"auto-v2",historyReady:!!M.sourceMaxDate};await pool().query("INSERT INTO bakery_plans(market_code,plan_date,generated_at,source_max_date,payload,weather,context) VALUES($1,$2,now(),$3,$4,$5,$6) ON CONFLICT(market_code,plan_date) DO UPDATE SET generated_at=now(),source_max_date=$3,payload=$4,weather=$5,context=$6",[MARKET,target,M.sourceMaxDate||null,payload,W,ctx]);return{payload,W,ctx,source:M.sourceMaxDate||null}}
async function autorun(mode){if(runPromise)return runPromise;runPromise=(async()=>{await init();let now=berlin(),target=mode==="morning"?now.date:add(now.date,1),key=`${mode}:${target}`;if((await pool().query("SELECT 1 FROM bakery_jobs WHERE job_key=$1 AND ran_at>now()-interval '6 hours'",[key])).rowCount)return{ok:true,skipped:true,target};let imported=await importMail().catch(e=>({error:e.message})),p=await plan(target);await pool().query("INSERT INTO bakery_jobs VALUES($1,now()) ON CONFLICT(job_key) DO UPDATE SET ran_at=now()",[key]);return{ok:true,target,imported,total:p.payload.totals.all,sourceMaxDate:p.source}})().finally(()=>runPromise=null);return runPromise}
async function mailboxBootstrap(){try{await init();let M=await loadModel(),r=await pool().query("SELECT 1 FROM bakery_jobs WHERE job_key='bakery-bootstrap-mail-v2'");if(r.rowCount||M.sourceMaxDate)return;await pool().query("INSERT INTO bakery_jobs(job_key,ran_at) VALUES('bakery-bootstrap-mail-v2',now()) ON CONFLICT DO NOTHING");let z=await importMail({days:390,maxMessages:120});if(z.sourceMaxDate){let now=berlin();await plan(now.date);await plan(add(now.date,1))}}catch(e){console.error("bakery bootstrap",e.message)}}
function json(res,s,b){res.writeHead(s,{"content-type":"application/json; charset=utf-8","cache-control":"no-store"});res.end(JSON.stringify(b))}
function read(req,limit=3500000){return new Promise((ok,no)=>{let s="",dead=false;req.on("data",c=>{if(dead)return;s+=c;if(s.length>limit){dead=true;no(Error("Datenmenge zu groß."))}});req.on("end",()=>{if(dead)return;try{ok(s?JSON.parse(s):{})}catch(e){no(e)}});req.on("error",no)})}
function autoWindow(){let{hour,minute}=berlin();if((hour===20&&minute>=30)||(hour===21&&minute<=10))return"evening";if(hour===5&&minute>=10&&minute<=30)return"morning";return""}
const slots=new Set;function revenueSlot(d,h,m){return((h===8&&[0,15,30,45].includes(m))||(h===9&&m===0))?`${d}-${h}:${m}`:""}
http.createServer=function(listener,...args){return original(async(req,res)=>{try{let u=new URL(req.url||"/","http://localhost"),p=u.pathname;if(p==="/api/bakery/auto"){let m=autoWindow();return json(res,200,m?await autorun(m):{ok:true,skipped:true,reason:"outside-window"})}
      if(p==="/api/bakery/model-status"){if(!auth(req,res))return;let M=await loadModel();return json(res,200,{ok:true,sourceMinDate:M.sourceMinDate||null,sourceMaxDate:M.sourceMaxDate||null,version:M.version||2})}
      if(p==="/api/bakery/history-seed"&&req.method==="POST"){if(!auth(req,res,true))return;let incoming=fixModel(await read(req));if(!incoming.sourceMaxDate||!/^\d{4}-\d{2}-\d{2}$/.test(incoming.sourceMaxDate)||!incoming.items||Object.keys(incoming.items).length<5)return json(res,400,{error:"Historie ist unvollständig."});let current=await loadModel(),curMax=current.sourceMaxDate||"",seedMax=incoming.sourceMaxDate;await saveModel(incoming);if(curMax&&curMax>seedMax)await importMail({days:5,maxMessages:30,forceAfter:seedMax}).catch(()=>{});let now=berlin();await plan(now.date);await plan(add(now.date,1));return json(res,200,{ok:true,seeded:true,sourceMaxDate:(await loadModel()).sourceMaxDate})}
      if(p==="/api/bakery/plans"){if(!auth(req,res))return;await init();let r=await pool().query("SELECT plan_date::text,generated_at,source_max_date::text,context FROM bakery_plans WHERE market_code=$1 ORDER BY plan_date DESC LIMIT 90",[MARKET]);return json(res,200,{ok:true,plans:r.rows})}
      if(p==="/api/bakery/plan"){if(!auth(req,res))return;await init();let d=String(u.searchParams.get("date")||"");if(!/^\d{4}-\d{2}-\d{2}$/.test(d))return json(res,400,{error:"Ungültiges Datum."});let r=await pool().query("SELECT plan_date::text,generated_at,source_max_date::text,payload,weather,context FROM bakery_plans WHERE market_code=$1 AND plan_date=$2",[MARKET,d]);if(!r.rowCount)return json(res,404,{error:"Plan nicht gefunden."});let a=await pool().query("SELECT article_no,interval_index,planned_qty,actual_qty,done_at FROM bakery_actuals WHERE market_code=$1 AND plan_date=$2",[MARKET,d]);r.rows[0].actuals=a.rows;let s=await pool().query("SELECT e.key article_no,COALESCE((z.v->>1)::numeric,0) sold_qty,COALESCE((z.v->>3)::numeric,0) writeoff_qty FROM bakery_model b CROSS JOIN LATERAL jsonb_each(COALESCE(b.payload->'items','{}'::jsonb)) e CROSS JOIN LATERAL jsonb_array_elements(COALESCE(e.value->'d','[]'::jsonb)) z(v) WHERE b.market_code=$1 AND z.v->>0=$2",[MARKET,d]);r.rows[0].sales=s.rows;let M=await loadModel(),planned=new Set((r.rows[0].payload?.items||[]).map(x=>String(x.no))),cat=catalog(),byCore=new Map;for(const it of cat){let k=core(it.name);if(!byCore.has(k))byCore.set(k,[]);byCore.get(k).push(it)}let outside=[];for(const[no,x]of Object.entries(M.u||{})){if(planned.has(String(no))||bakeryRepairFindV3(x.n,cat,byCore))continue;let e=(x.d||[]).find(v=>Array.isArray(v)&&v[0]===d);if(!e||!(+e[1]>0||+e[3]>0))continue;outside.push({article_no:String(no),article_name:x.n||String(no),sold_qty:+e[1]||0,writeoff_qty:+e[3]||0,action_qty:+e[4]||0})}outside.sort((x,y)=>y.sold_qty-x.sold_qty||String(x.article_name).localeCompare(String(y.article_name),'de'));r.rows[0].outsidePlan=outside;return json(res,200,{ok:true,plan:r.rows[0]})}
      if(p==="/api/bakery/actual"&&req.method==="POST"){if(!auth(req,res))return;await init();let x=await read(req,20000),today=berlin().date,date=String(x.date||""),no=String(x.articleNo||""),idx=+x.intervalIndex,actual=Math.max(0,Math.min(5000,Math.round(+x.actualQty||0)));if(date!==today||!/^\d{6,12}$/.test(no)||![0,1,2].includes(idx))return json(res,400,{error:"Ungültige Produktionsmeldung."});let r=await pool().query("SELECT payload FROM bakery_plans WHERE market_code=$1 AND plan_date=$2",[MARKET,date]);if(!r.rowCount)return json(res,404,{error:"Plan nicht gefunden."});let it=(r.rows[0].payload?.items||[]).find(z=>String(z.no)===no),planned=Math.max(0,Math.round(+it?.buckets?.[idx]||0));if(!it)return json(res,400,{error:"Artikel gehört nicht zum Plan."});await pool().query("INSERT INTO bakery_actuals VALUES($1,$2,$3,$4,$5,$6,now()) ON CONFLICT(market_code,plan_date,article_no,interval_index) DO UPDATE SET planned_qty=$5,actual_qty=$6,done_at=now()",[MARKET,date,no,idx,planned,actual]);return json(res,200,{ok:true,plannedQty:planned})}
      if(p==="/api/jobs/revenue-import"){let z=berlin(),sl=revenueSlot(z.date,z.hour,z.minute);if(!sl||slots.has(sl))return json(res,200,{ok:true,skipped:true});slots.add(sl)}}catch(e){console.error("wrapper",e);if(!res.headersSent)return json(res,500,{error:e.message})}return listener(req,res)},...args)};
const{startServer}=require("./server-core");startServer().then(()=>setTimeout(mailboxBootstrap,20000).unref()).catch(e=>{console.error(e);process.exit(1)});
