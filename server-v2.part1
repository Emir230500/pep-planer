"use strict";
require("./neon-query-cache");
const http=require("http"),crypto=require("crypto"),fs=require("fs"),path=require("path");
const original=http.createServer.bind(http), MARKET="802163", TZ="Europe/Berlin", LAT=51.90724, LON=8.61329;
let pg,initDone=false,runPromise=null,modelCache=null;
function pool(){if(!pg){const{Pool}=require("pg");pg=new Pool({connectionString:process.env.DATABASE_URL,ssl:process.env.DATABASE_SSL==="false"?false:{rejectUnauthorized:false}})}return pg}
async function init(){if(initDone)return;const p=pool();await p.query(`CREATE TABLE IF NOT EXISTS bakery_q15(market_code text,sale_date date,slot time,article_no text,article_name text,qty numeric,revenue numeric,PRIMARY KEY(market_code,sale_date,slot,article_no));CREATE TABLE IF NOT EXISTS bakery_daily(market_code text,sale_date date,article_no text,article_name text,qty numeric,revenue numeric,writeoff numeric,action_qty numeric,PRIMARY KEY(market_code,sale_date,article_no));CREATE TABLE IF NOT EXISTS bakery_mail(source_id text PRIMARY KEY,imported_at timestamptz default now());CREATE TABLE IF NOT EXISTS bakery_plans(market_code text,plan_date date,generated_at timestamptz default now(),source_max_date date,payload jsonb,weather jsonb,context jsonb,PRIMARY KEY(market_code,plan_date));CREATE TABLE IF NOT EXISTS bakery_actuals(market_code text,plan_date date,article_no text,interval_index int,planned_qty int,actual_qty int,done_at timestamptz default now(),PRIMARY KEY(market_code,plan_date,article_no,interval_index));CREATE TABLE IF NOT EXISTS bakery_jobs(job_key text PRIMARY KEY,ran_at timestamptz default now());CREATE TABLE IF NOT EXISTS bakery_model(market_code text PRIMARY KEY,payload jsonb NOT NULL,updated_at timestamptz NOT NULL DEFAULT now())`);initDone=true}
const n=s=>String(s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/ß/g,"ss").replace(/[^a-z0-9]+/g," ").trim();
const num=v=>{if(typeof v==="number")return Number.isFinite(v)?v:0;let s=String(v??"").trim();if(!s)return 0;if(s.includes(","))s=s.replace(/\./g,"").replace(",",".");const x=Number(s.replace(/[^0-9+.-]/g,""));return Number.isFinite(x)?x:0};
const iso=v=>{if(v instanceof Date&&!isNaN(v))return v.toISOString().slice(0,10);let s=String(v||"").trim(),m=s.match(/^(\d{1,2})[.\/-](\d{1,2})[.\/-](\d{2,4})$/);if(m){let y=+m[3];if(y<100)y+=2000;return `${y}-${m[2].padStart(2,"0")}-${m[1].padStart(2,"0")}`}m=s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);return m?`${m[1]}-${m[2].padStart(2,"0")}-${m[3].padStart(2,"0")}`:""};
const article=v=>(String(v||"").match(/\b(\d{6,12})\b/)||[])[1]||"";
function slot(v){const m=String(v||"").match(/(\d{1,2}):?(\d{2})/);return m?`${m[1].padStart(2,"0")}:${m[2]}:00`:""}
function hk(v){const h=n(v);if(h==="kalendertag"||h==="datum")return"date";if(h.includes("viertelstunde"))return"slot";if(h==="artikel"||h.includes("artikelnummer"))return"article";if(h.includes("artikelbezeichnung")||h==="bezeichnung"||h==="artikelname")return"name";if(h==="menge")return"qty";if(h==="umsatz")return"revenue";if(h.includes("vollabschrift")||h.includes("abschrift"))return"writeoff";if(h.includes("aktion")&&h.includes("menge"))return"action";return""}
function berlin(){const a=new Intl.DateTimeFormat("en-CA",{timeZone:TZ,year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit",hourCycle:"h23"}).formatToParts(new Date()),o=Object.fromEntries(a.map(x=>[x.type,x.value]));return{date:`${o.year}-${o.month}-${o.day}`,hour:+o.hour,minute:+o.minute}}
function add(d,x){const z=new Date(d+"T12:00:00Z");z.setUTCDate(z.getUTCDate()+x);return z.toISOString().slice(0,10)}
function wd(d){return new Date(d+"T12:00:00Z").getUTCDay()}
function daysBetween(a,b){return Math.round((new Date(b+"T12:00:00Z")-new Date(a+"T12:00:00Z"))/86400000)}
function median(a){a=a.filter(Number.isFinite).sort((x,y)=>x-y);if(!a.length)return 0;let m=Math.floor(a.length/2);return a.length%2?a[m]:(a[m-1]+a[m])/2}
function weighted(a){let s=0,w=0;for(const x of a){s+=x.value*x.weight;w+=x.weight}return w?s/w:0}
function clamp(v,a,b){return Math.max(a,Math.min(b,v))}
function catalog(){const s=fs.readFileSync(path.join(__dirname,"public/backprognose.js"),"utf8"),m=s.match(/const REFERENCE_PLAN\s*=\s*(\[[\s\S]*?\]);\s*\n\s*const state/);return m?Function(`return (${m[1]})`)():[]}
const STOP=new Set("g gg b o bo harry preb prebake preback pb bake off bio e fs cl herzstucke herz schaefers schafers jude juede bakerm panobake deh h s ef afs ary europ filly csm topkauf brink edeka gut gunstig ca bv va kg st stk gramm geschnitten vorgeschnitten".split(" "));
function core(s){return n(s).replace(/nougatcr/g,"nougat").replace(/schokoladengla/g,"schokoladenglasur").replace(/crodots/g,"crodot").split(" ").filter(x=>x&&!STOP.has(x)&&!/^\d+$/.test(x)).join(" ")}
function brand(value){const s=n(value);if(s.includes("jude"))return"juede";if(s.includes("harry"))return"harry";if(s.includes("schafers"))return"schaefers";if(s.includes("panobake"))return"panobake";if(s.includes("e fs"))return"efs";if(s.includes("herz"))return"herz";if(s.includes("g g"))return"gg";if(s.includes("bio e"))return"bioe";return""}
function brandOk(a,b){a=brand(a);b=brand(b);if(["juede","harry","schaefers","panobake","efs","herz","bioe"].includes(a))return a===b;if(a==="gg")return b==="gg"||b==="";return true}
function match(i,name){let a=core(i.name),b=core(name);if(i.name==="Berliner Auswahl")return b.includes("berliner")&&!/\b(?:4|6|8|12)\s*st\b/.test(n(name));if(i.name==="Donut Auswahl")return b.includes("donut")&&!b.includes("crodot")&&!/\b(?:4|6|8|12)\s*st\b/.test(n(name));if(i.name==="Laugenkranz Auswahl")return b.includes("laugenkranz");return a&&a===b&&brandOk(i.name,name)}
function weightKg(name){let m=[...String(name||"").matchAll(/(\d+(?:[.,]\d+)?)\s*(kg|g)\b/gi)].at(-1);if(!m)return 0;let x=+m[1].replace(",",".");return m[2].toLowerCase()==="kg"?x:x/1000}
function qFor(i,r){let q=Math.max(0,+r.qty||0),k=weightKg(i.name),fractional=Math.abs(q-Math.round(q))>.0001;return fractional&&k&&/(brot|baguette|ciabatta|kruste|kassler|paderborner|laib)/.test(n(i.name))?q/k:q}
function easter(y){let a=y%19,b=Math.floor(y/100),c=y%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),mo=Math.floor((h+l-7*m+114)/31),da=(h+l-7*m+114)%31+1;return `${y}-${String(mo).padStart(2,"0")}-${String(da).padStart(2,"0")}`}
function holiday(d){let y=+d.slice(0